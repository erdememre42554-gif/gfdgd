{
  "name": "ParseFrame — local developer tools",
  "short_name": "ParseFrame",
  "description": "Browser-local developer and data tools. Inspect, transform and verify data without sending it away.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#090d12",
  "theme_color": "#090d12",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ]
}
